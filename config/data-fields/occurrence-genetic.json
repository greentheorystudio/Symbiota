{
    "idoccurgenetic": {
        "dataType": "number",
        "length": 11
    },
    "occid": {
        "dataType": "number",
        "length": 10
    },
    "sourceidentifier": {
        "dataType": "string",
        "length": 150,
        "comments": "GenBank accession # or BOLD record #."
    },
    "sourcename": {
        "dataType": "string",
        "length": 150,
        "comments": "Public database (e.g., GenBank, Barcode of Life Data Systems) containing the genetic record."
    },
    "description": {
        "dataType": "string",
        "length": 500,
        "comments": "Title of GenBank or Bold record; same as 'Identifier' for BOLD records, which don't have titles."
    },
    "targetgene": {
        "dataType": "string",
        "length": 500,
        "source": "https://rs.gbif.org/extension/gbif/1.0/dna_derived_data_2024-07-11.xml#target_gene",
        "definition": "Targeted gene or locus name for marker gene studies",
        "comments": "Physcial location of a gene (e.g., COI, 16S).",
        "examples": "16S rRNA, 18S rRNA, nif, amoA, rpo"
    },
    "targetsubfragment": {
        "dataType": "string",
        "length": 500,
        "source": "https://rs.gbif.org/extension/gbif/1.0/dna_derived_data_2024-07-11.xml#target_subfragment",
        "definition": "Name of subfragment of a gene or locus. Important to e.g. identify special regions on marker genes like V6 on 16S rRNA",
        "comments": "Special region (e.g., V6 on 16S rRNA).",
        "examples": "V6, V9, ITS"
    },
    "dnasequence": {
        "dataType": "text",
        "length": 0,
        "source": "https://rs.gbif.org/extension/gbif/1.0/dna_derived_data_2024-07-11.xml#DNA_sequence",
        "definition": "The DNA sequence",
        "examples": "TCTATCCTCAATTATAGGTCATAATTCACCATCAGTAGATTTAGG..."
    },
    "url": {
        "dataType": "text",
        "length": 0,
        "source": "https://rs.gbif.org/extension/gbif/1.0/dna_derived_data_2024-07-11.xml#url",
        "comments": "URL of the genetic record.",
        "examples": "http://www.earthmicrobiome.org/"
    },
    "notes": {
        "dataType": "string",
        "length": 1000,
        "comments": "Catch-all notes field."
    },
    "authors": {
        "dataType": "string",
        "length": 500,
        "comments": "Names of the authors of the genetic record."
    },
    "authorinstitution": {
        "dataType": "string",
        "length": 500,
        "comments": "Home institution of author(s); in the first 'journal' field of a GenBank record."
    },
    "reference": {
        "dataType": "string",
        "length": 750,
        "comments": "Peer-reviewed publication associated with the genetic record; often in the second 'journal' field of a GenBank record; use DOI when available."
    },
    "guid": {
        "dataType": "string",
        "length": 45
    },
    "initialtimestamp": {
        "dataType": "timestamp",
        "length": 0
    }
}
